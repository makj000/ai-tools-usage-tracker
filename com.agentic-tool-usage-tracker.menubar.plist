<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentic-tool-usage-tracker.menubar</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__ROOT__/run_menubar.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/launchd.stderr.log</string>
</dict>
</plist>
